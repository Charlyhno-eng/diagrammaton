{
  "name": "diagrammaton",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "test:watch": "vitest",
    "gif:service": "node --import tsx gif-service.ts",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "playwright": "^1.63.0",
    "react": "latest",
    "react-dom": "latest",
    "react-router-dom": "latest",
    "sharp": "^0.35.4",
    "simple-icons": "^16.31.0"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.3",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "autoprefixer": "latest",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "tailwindcss": "latest",
    "tsx": "^4.23.13",
    "typescript": "~5.7.2",
    "typescript-eslint": "latest",
    "vite": "latest",
    "vitest": "^5.0.1"
  }
}
